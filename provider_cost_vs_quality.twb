    <worksheet name='Recommendation_Map'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>Hospital Recommendation Map</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hospitals_for_map_tableau' name='federated.1umtn5h1qpp2h616za1lm0yg6911' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1umtn5h1qpp2h616za1lm0yg6911'>
            <column caption='Facility Name' datatype='string' name='[Facility Name_x]' role='dimension' type='nominal' />
            <column aggregation='Avg' caption='Latitude m' datatype='real' name='[Latitude_m]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
            <column aggregation='Avg' caption='Longitude m' datatype='real' name='[Longitude_m]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
            <column datatype='real' name='[Overall Score]' role='measure' type='quantitative' />
            <column datatype='string' name='[Payment Measure ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Facility Name_x]' derivation='None' name='[none:Facility Name_x:nk]' pivot='key' type='nominal' />
            <column-instance column='[Latitude_m]' derivation='None' name='[none:Latitude_m:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Longitude_m]' derivation='None' name='[none:Longitude_m:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Overall Score]' derivation='None' name='[none:Overall Score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Payment Measure ID]' derivation='None' name='[none:Payment Measure ID:nk]' pivot='key' type='nominal' />
            <column-instance column='[State]' derivation='None' name='[none:State:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1umtn5h1qpp2h616za1lm0yg6911].[Exclusions (Facility Name x,Latitude m,Longitude m,Overall Score)]' filter-group='8'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='level-members' level='[none:Facility Name_x:nk]' />
                <groupfilter function='level-members' level='[none:Latitude_m:qk]' />
                <groupfilter function='level-members' level='[none:Longitude_m:qk]' />
                <groupfilter function='level-members' level='[none:Overall Score:qk]' />
              </groupfilter>
              <groupfilter function='reorder-dimensionality'>
                <groupfilter function='union'>
                  <groupfilter function='crossjoin'>
                    <groupfilter function='member' level='[none:Overall Score:qk]' member='2.0' />
                    <groupfilter function='crossjoin'>
                      <groupfilter function='member' level='[none:Facility Name_x:nk]' member='&quot;COMMUNITY HOSPITAL&quot;' />
                      <groupfilter function='crossjoin'>
                        <groupfilter function='member' level='[none:Latitude_m:qk]' member='35.375420550000001' />
                        <groupfilter function='member' level='[none:Longitude_m:qk]' member='-97.570475126582281' />
                      </groupfilter>
                    </groupfilter>
                  </groupfilter>
                  <groupfilter function='crossjoin'>
